# Copy to .env and fill in. All values are read and validated in src/config/env.ts.

PORT=4000

# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster/kesari
MONGODB_URI=

# At least 32 random characters
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# AWS S3 for media uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Leave the keys empty to use the default AWS credential chain (IAM role, profile, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional public base URL for uploaded files (e.g. a CloudFront domain)
AWS_S3_PUBLIC_URL=

MAX_UPLOAD_MB=15
