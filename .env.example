# Copy to .env on the server. Do not commit the real .env.

# Public hostname (DNS A record → this server). Site, /admin, /api, /img all use it.
DOMAIN=kesari.example.com

# Host ports nginx proxies to (defaults match deploy/nginx.conf.example)
# FRONTEND_HOST_PORT=3020
# BACKEND_HOST_PORT=4000

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=15
PAGE_SIZE=20
LOG_LEVEL=info
