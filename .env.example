# Production settings for docker-compose.yml. Copy to .env on the server and fill in.
# Never commit the real .env.

# ---- Public site ----
# The domain the site is served on (DNS A/AAAA record must point at this server).
# The site, the CMS (/admin), the API (/api) and media (/img) all live on it.
DOMAIN=kesari.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# ---- API (backend) ----
# MongoDB Atlas (recommended): mongodb+srv://user:pass@cluster.mongodb.net/kesari
# Bundled container (--profile local-db): mongodb://mongo:27017/kesari
MONGODB_URI=

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AWS S3 for the media library. Leave the keys empty to use an IAM role.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=15
PAGE_SIZE=20
LOG_LEVEL=info

# CORS_ORIGINS and AWS_S3_PUBLIC_URL are derived from DOMAIN in docker-compose.yml.
